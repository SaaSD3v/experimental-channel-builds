#!/bin/sh
set -eu

G=/sys/kernel/config/usb_gadget/channel

modprobe configfs 2>/dev/null || true
modprobe libcomposite 2>/dev/null || true
if ! /bin/busybox mountpoint -q /sys/kernel/config; then
    mount -t configfs configfs /sys/kernel/config
fi

i=0
while [ ! -e /sys/class/udc/* ]; do
    i=$((i + 1))
    [ "$i" -lt 60 ] || {
        echo "channel-usb: no UDC registered" >&2
        exit 1
    }
    sleep 1
done

UDC="$(basename "$(find /sys/class/udc -mindepth 1 -maxdepth 1 -print -quit)")"

if [ -d "$G" ]; then
    if [ -f "$G/UDC" ]; then
        printf '%s' "" > "$G/UDC" 2>/dev/null || true
    fi
    rm -f "$G/configs/c.1/rndis.usb0" "$G/os_desc/c.1" 2>/dev/null || true
    rmdir "$G/functions/rndis.usb0" 2>/dev/null || true
    rmdir "$G/configs/c.1/strings/0x409" "$G/configs/c.1" 2>/dev/null || true
    rmdir "$G/strings/0x409" 2>/dev/null || true
    rmdir "$G" 2>/dev/null || true
fi

mkdir -p "$G"
cd "$G"

printf '0x1d6b' > idVendor
printf '0x0104' > idProduct
printf '0x0200' > bcdUSB
printf '0x0100' > bcdDevice

printf '0xEF' > bDeviceClass
printf '0x02' > bDeviceSubClass
printf '0x01' > bDeviceProtocol

mkdir -p strings/0x409
SERIAL="$(
    {
        cat /sys/devices/soc0/serial_number 2>/dev/null ||
        tr -d '\000' </proc/device-tree/serial-number 2>/dev/null ||
        cat /etc/machine-id 2>/dev/null ||
        true
    } | tr -cd '0-9A-Za-z' | head -c 16
)"
[ -n "$SERIAL" ] || SERIAL=alpine
printf 'channel-%s' "$SERIAL" > strings/0x409/serialnumber
printf 'Motorola Moto G7 Play Linux' > strings/0x409/manufacturer
printf 'channel Alpine USB RNDIS' > strings/0x409/product

printf '1' > os_desc/use
printf '0xcd' > os_desc/b_vendor_code
printf 'MSFT100' > os_desc/qw_sign

mkdir -p configs/c.1/strings/0x409
printf 'RNDIS network for SSH' > configs/c.1/strings/0x409/configuration
printf '250' > configs/c.1/MaxPower

mkdir -p functions/rndis.usb0
printf '02:00:00:00:42:01' > functions/rndis.usb0/dev_addr
printf '02:00:00:00:42:02' > functions/rndis.usb0/host_addr
if [ -w functions/rndis.usb0/ifname ]; then
    printf 'usb%%d' > functions/rndis.usb0/ifname 2>/dev/null || true
fi

if [ -d functions/rndis.usb0/os_desc/interface.rndis ]; then
    printf 'RNDIS' > functions/rndis.usb0/os_desc/interface.rndis/compatible_id
    printf '5162001' > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id
fi

ln -s functions/rndis.usb0 configs/c.1/rndis.usb0
ln -s configs/c.1 os_desc/c.1

printf '%s' "$UDC" > UDC

i=0
while [ ! -d /sys/class/net/usb0 ]; do
    i=$((i + 1))
    [ "$i" -lt 20 ] || {
        echo "channel-usb: gadget bound to $UDC but usb0 did not appear" >&2
        exit 1
    }
    sleep 1
done

ip link set usb0 down 2>/dev/null || true
ip addr flush dev usb0
ip link set dev usb0 address 02:00:00:00:42:01
ip addr add 172.16.42.1/24 dev usb0
ip link set usb0 up

echo "channel-usb: RNDIS ready on $UDC, device 172.16.42.1"
