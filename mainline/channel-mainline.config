# Moto G7 Play (channel) bring-up requirements
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y

# Root filesystem on microSD / eMMC
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# USB controller and gadget stack
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y

# Networking required for SSH over USB RNDIS
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y

# Useful during early mainline bring-up
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y

# Channel WCNSS / Pronto Wi-Fi path
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
